# Settings of the Agent Manager demo. Keys are not here: ./run.sh writes the
# ones Agent Manager hands out to secrets.env (not in Git).

# The bank the agents work for, and the customer of the main demo's bank.
BANK_NAME=Bank of Asgard
CUSTOMER_NAME=Sam Taylor

# Agent Manager as its quick start installs it, with its built-in admin client.
AMP_CONSOLE_URL=http://console.amp.localhost:8080
AMP_API_URL=http://api.amp.localhost:8080/api/v1
AMP_TRACES_URL=http://traces.amp.localhost:11080/api/v1
AMP_TOKEN_URL=http://thunder.amp.localhost:8080/oauth2/token
AMP_CLIENT_ID=amp-api-client
AMP_CLIENT_SECRET=amp-api-client-secret
AMP_ORG=default
AMP_PROJECT=bank
AMP_ENVIRONMENT=default
# Where the agents send their traces.
AMP_OTEL_ENDPOINT=http://default-default.gateway.localhost:19080/otel

# The keys read once to register the models in Agent Manager: a file and the
# variable in it. The agents never see them. Claude does the work, Gemini
# judges it in the quality checks.
ANTHROPIC_KEY_SOURCE=../wso2-api-platform-ai-demo/secrets/api-keys.env:ANTHROPIC_API_KEY
GEMINI_KEY_SOURCE=../wso2-api-platform-ai-demo/secrets/api-keys.env:GEMINI_API_KEY

# The main demo, whose gateways the agents use for tools (MCP) and other
# agents (A2A), as in its MCP and A2A showcases. Left empty, the gateway
# addresses follow the main demo's ports on this machine.
MAIN_DEMO_DIR=../wso2-api-platform-ai-demo
GATEWAY_URL=
A2A_GATEWAY_URL=
MCP_ROUTE=/bank/acme-mcp/mcp
TRAVEL_MONEY_ROUTE=/bank/acme-agent
TRAVEL_INSURANCE_ROUTE=/bank/partner-agent
# The partner's agent through its own card, not the one the gateway vetted (the incident).
TRAVEL_INSURANCE_OWN_ROUTE=/bank/partner-agent-own
# The bank's product catalogue the Policy Advisor answers from.
CATALOGUE_FILE=../wso2-api-platform-ai-demo/verticals/bank/catalogue.md

# The model every agent uses. Claude Haiku 4.5 keeps the demo cheap and quick.
MODEL=claude-haiku-4-5
# How hard the model thinks (low, medium, high), for the models that take it:
# Claude 4.6 and later. Leave it empty for Claude Haiku 4.5.
EFFORT=

# The demo's page, and the main demo's chatbot it links back to.
PAGE_PORT=8610
MAIN_DEMO_URL=http://localhost:8600
