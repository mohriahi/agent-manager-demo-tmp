# Settings of the Agent Manager demo. It runs next to the main demo and uses
# its gateways; nothing here changes the main demo. setup.py writes the keys
# it creates, and the values it reads from the main demo, to secrets.env
# (not in Git).

# The main demo's folder (wso2-api-platform-ai-demo), where setup.py reads its
# brand, its gateway ports and the LLM route's key.
MAIN_DEMO_DIR=../wso2-api-platform-ai-demo

# The bank the agents work for. Empty: the main demo's brand.
BANK_NAME=

# Agent Manager as its quick start installs it, with its built-in admin client.
AMP_CONSOLE_URL=http://console.amp.localhost:8080
AMP_API_URL=http://api.amp.localhost:8080/api/v1
AMP_TOKEN_URL=http://thunder.amp.localhost:8080/oauth2/token
AMP_CLIENT_ID=amp-api-client
AMP_CLIENT_SECRET=amp-api-client-secret
AMP_ORG=default
AMP_PROJECT=bank
AMP_ENVIRONMENT=default
# Where the agents send their traces.
AMP_OTEL_ENDPOINT=http://default-default.gateway.localhost:19080/otel

# The main demo's gateways as the agents reach them from Docker. Empty: this
# machine's ports for the main demo.
GATEWAY_URL=
A2A_GATEWAY_URL=
# The routes the agents use on them: the plain LLM route, the Core Banking MCP
# route with no rule, and the two A2A agents.
LLM_ROUTE=/bank/anthropic-plain
MCP_ROUTE=/bank/acme-mcp/mcp
TRAVEL_MONEY_ROUTE=/bank/acme-agent
TRAVEL_INSURANCE_ROUTE=/bank/partner-agent
# Where the LLM route's key is: a file in the main demo's folder and the
# variable in it.
LLM_KEY_SOURCE=secrets/gateway-keys.env:SHOWCASE_BANK_PLAIN_CHAT_API_KEY

# The demo's page, and the main demo's chatbot it links back to.
PAGE_PORT=8610
MAIN_DEMO_URL=http://localhost:8600
